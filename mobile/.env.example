# Leave empty for a local journal on this device (AsyncStorage).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CONVEX_URL=

# PostHog (EU). Public project token, safe in client code.
# Needs a new native binary: expo-application, expo-device, and expo-localization.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
