# Web (Next.js) — leave empty for a local journal on this device
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=

# Convex dashboard env (Clerk JWT issuer, e.g. https://your-app.clerk.accounts.dev)
CLERK_JWT_ISSUER_DOMAIN=

# PostHog (EU). Public project token, safe in client code.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
